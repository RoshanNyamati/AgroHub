// AgroHub Production Prisma Schema (PostgreSQL + PostGIS Geospatial Indexing)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum UserRole {
  FARMER
  OWNER
  DISPATCHER
}

enum EquipmentCategory {
  TRACTOR
  HARVESTER
  PLANTER
  SPRAYER
  TILLER
}

enum EquipmentStatus {
  AVAILABLE
  IN_USE
  MAINTENANCE
  WEATHER_HOLD
}

enum BookingStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  RESCHEDULED
  COMPLETED
  REJECTED
  CANCELLED
}

enum DisruptionType {
  RAIN
  BREAKDOWN
  ROAD_CLOSURE
}

enum DisruptionSeverity {
  LOW
  MODERATE
  CRITICAL
}

model User {
  id           String      @id @default(cuid())
  fullName     String
  phone        String      @unique
  email        String?     @unique
  role         UserRole    @default(FARMER)
  villageName  String
  latitude     Float
  longitude    Float
  location     Unsupported("geography(Point, 4326)")?
  rating       Float       @default(5.0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  ownedEquipment Equipment[] @relation("EquipmentOwner")
  plots          Plot[]      @relation("PlotFarmer")
  bookings       Booking[]   @relation("BookingFarmer")

  @@index([role])
  @@index([latitude, longitude])
  @@index([location], type: Gist)
}

model Equipment {
  id                String            @id @default(cuid())
  ownerId           String
  name              String
  modelCode         String
  category          EquipmentCategory
  status            EquipmentStatus   @default(AVAILABLE)
  hourlyRateInr     Float
  workRateAcresHr   Float
  transitSpeedKmh   Float             @default(22.0)
  horsepower        Int
  baseVillage       String
  latitude          Float
  longitude         Float
  location          Unsupported("geography(Point, 4326)")?
  imageUrl          String
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  owner       User         @relation("EquipmentOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  bookings    Booking[]
  disruptions Disruption[]

  @@index([ownerId])
  @@index([category, status])
  @@index([latitude, longitude])
  @@index([location], type: Gist)
}

model Plot {
  id               String   @id @default(cuid())
  farmerId         String
  name             String
  cropType         String
  areaAcres        Float
  villageName      String
  latitude         Float
  longitude        Float
  location         Unsupported("geography(Point, 4326)")?
  requiredCategory EquipmentCategory
  targetStartAt    DateTime
  deadlineAt       DateTime
  soilCondition    String   @default("Dry Loam")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  farmer   User      @relation("PlotFarmer", fields: [farmerId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([farmerId])
  @@index([deadlineAt])
  @@index([latitude, longitude])
  @@index([location], type: Gist)
}

model Booking {
  id                   String        @id @default(cuid())
  equipmentId          String
  plotId               String
  farmerId             String
  status               BookingStatus @default(PENDING)
  effectiveStartAt     DateTime
  fieldStartAt         DateTime
  endAt                DateTime
  travelMinutes        Int
  workMinutes          Int
  transitDistanceKm    Float
  estimatedCostInr     Float
  priorityScore        Float         @default(0)
  sequenceOrder        Int           @default(0)
  rescheduleReason     String?
  notes                String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  plot      Plot      @relation(fields: [plotId], references: [id], onDelete: Cascade)
  farmer    User      @relation("BookingFarmer", fields: [farmerId], references: [id], onDelete: Cascade)

  @@index([equipmentId, effectiveStartAt, endAt])
  @@index([plotId])
  @@index([farmerId, status])
  @@index([status, priorityScore(sort: Desc)])
}

model Disruption {
  id              String             @id @default(cuid())
  equipmentId     String?
  type            DisruptionType
  severity        DisruptionSeverity
  title           String
  description     String
  affectedRadiusKm Float             @default(15.0)
  centerLat       Float
  centerLng       Float
  location        Unsupported("geography(Point, 4326)")?
  delayHours      Int
  resolved        Boolean            @default(false)
  cascadeSummary  String[]
  createdAt       DateTime           @default(now())
  resolvedAt      DateTime?

  equipment Equipment? @relation(fields: [equipmentId], references: [id], onDelete: SetNull)

  @@index([resolved, createdAt(sort: Desc)])
  @@index([equipmentId])
  @@index([location], type: Gist)
}
